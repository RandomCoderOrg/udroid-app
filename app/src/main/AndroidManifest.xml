<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".UdroidApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Udroid"
        tools:replace="android:icon,android:roundIcon,android:theme">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The Termux:X11 library currently contributes its standalone app
          components. uDroid embeds the renderer and X server, but owns all
          Activities, services, preferences, and lifecycle itself.
        -->
        <activity
            android:name="com.termux.x11.MainActivity"
            tools:node="remove" />
        <activity
            android:name="com.termux.x11.LoriePreferences"
            tools:node="remove" />
        <service
            android:name="com.termux.x11.utils.KeyInterceptor"
            tools:node="remove" />
        <receiver
            android:name="com.termux.x11.LoriePreferences$Receiver"
            tools:node="remove" />

        <service
            android:name=".install.InstallerService"
            android:description="@string/installer_description"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <service
            android:name=".runtime.RuntimeSupervisorService"
            android:description="@string/supervisor_description"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-requested local Linux runtime and child-process supervision" />
        </service>

        <service
            android:name=".x11.X11ServerService"
            android:exported="false"
            android:process=":x11"
            android:stopWithTask="false" />
    </application>

</manifest>
