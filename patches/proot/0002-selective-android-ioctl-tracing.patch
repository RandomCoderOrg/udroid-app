+#ifdef __ANDROID__
+#define LENGTH_TRACE_ANDROID_IOCTL 14
+
+/* Only requests rewritten in enter.c or exit.c need the ptrace round trip. */
+static int add_trace_android_ioctl(struct sock_fprog *program, word_t syscall)
+{
+	const uint32_t requests[] = {
+		TCSETS + 2,
+		TCGETS2,
+		TCSETS2,
+		TCSETSW2,
+		TCSETSF2,
+		_IOW(0x94, 9, int), /* FICLONE */
+	};
+	const size_t request_offset = offsetof(struct seccomp_data, args[1]);
+	struct sock_filter start[] = {
+		BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, syscall, 0,
+			LENGTH_TRACE_ANDROID_IOCTL - 1),
+		BPF_STMT(BPF_LD + BPF_W + BPF_ABS, request_offset),
+	};
+	size_t i;
+	int status;
+
+	if (syscall > UINT32_MAX || request_offset > UINT32_MAX)
+		return -ERANGE;
+
+	status = add_statements(program, sizeof(start) / sizeof(start[0]), start);
+	if (status < 0)
+		return status;
+
+	for (i = 0; i < sizeof(requests) / sizeof(requests[0]); i++) {
+		struct sock_filter request[] = {
+			BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, requests[i], 0, 1),
+			BPF_STMT(BPF_RET + BPF_K,
+				SECCOMP_RET_TRACE + FILTER_SYSEXIT),
+		};
+
+		status = add_statements(program,
+				sizeof(request) / sizeof(request[0]), request);
+		if (status < 0)
+			return status;
+	}
 
 	return 0;
 }
+#endif
 
