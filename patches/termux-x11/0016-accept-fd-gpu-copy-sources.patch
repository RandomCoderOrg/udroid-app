Accept existing DMA-BUF and AHardwareBuffer pixmaps as GPU-copy sources.

The renderer already handles both source types. Requiring AHardwareBuffer here
rejects Venus/Zink's CPU-mappable DMA-BUF pixmaps and forces Present through the
CPU fallback.

--- a/InitOutput.c
+++ b/InitOutput.c
@@ -135,6 +135,19 @@ static LorieBuffer *lorieEnsureGpuSampleable(PixmapPtr pixmap, int8_t type) {
     return desc->type == type ? priv->buffer : NULL;
 }
 
+static LorieBuffer *lorieGpuCopySource(PixmapPtr pixmap) {
+    LoriePixmapPriv *priv = LORIE_PIXMAP_PRIV_FROM_PIXMAP(pixmap);
+    const LorieBuffer_Desc *desc;
+    if (!priv || !priv->buffer || priv->mem)
+        return NULL;
+
+    desc = LorieBuffer_description(priv->buffer);
+    if (desc->type == LORIEBUFFER_FD || desc->type == LORIEBUFFER_AHARDWAREBUFFER)
+        return priv->buffer;
+
+    return lorieEnsureGpuSampleable(pixmap, LORIEBUFFER_AHARDWAREBUFFER);
+}
+
 static Bool lorieServerDebugEnabled = FALSE;
 
 void OsVendorInit(void) {
@@ -867,7 +880,7 @@ Bool lorieTryScheduleGpuCopy(PixmapPtr pixmap, PixmapPtr dst, RegionPtr update,
         return FALSE;
     }
 
-    if (!(srcBuffer = lorieEnsureGpuSampleable(pixmap, LORIEBUFFER_AHARDWAREBUFFER))) {
+    if (!(srcBuffer = lorieGpuCopySource(pixmap))) {
         static uint8_t logged = 0;
         LoriePixmapPriv *failed = LORIE_PIXMAP_PRIV_FROM_PIXMAP(pixmap);
         const LorieBuffer_Desc *failedDesc = failed && failed->buffer ? LorieBuffer_description(failed->buffer) : NULL;
