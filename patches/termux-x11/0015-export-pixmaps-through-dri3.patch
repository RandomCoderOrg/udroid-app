 #include <stdbool.h>
 #include <stdint.h>
 #include <linux/dma-buf.h>
+#include <linux/dma-heap.h>
 #include <linux/memfd.h>
 #include <sys/ioctl.h>
 #include <sys/mman.h>
@@ -142,6 +143,49 @@ static inline size_t alignToPage(size_t size) {
     return (size + page_size - 1) & ~(page_size - 1);
 }
 
+static inline int32_t alignGpuSampledStride(int32_t width) {
+    const int32_t pixelsPerAlignment = 64 / sizeof(uint32_t);
+    return (width + pixelsPerAlignment - 1) & ~(pixelsPerAlignment - 1);
+}
+
+static int createDmaHeapRegion(size_t size) {
+    static const char *const heapPaths[] = {
+        "/dev/dma_heap/system-uncached",
+        "/dev/dma_heap/system",
+    };
+    struct dma_heap_allocation_data allocation = {
+        .len = alignToPage(size),
+        .fd_flags = O_RDWR | O_CLOEXEC,
+    };
+
+    for (size_t i = 0; i < sizeof(heapPaths) / sizeof(heapPaths[0]); i++) {
+        int heap = open(heapPaths[i], O_RDONLY | O_CLOEXEC);
+        if (heap < 0)
+            continue;
+
+        int result;
+        do {
+            result = ioctl(heap, DMA_HEAP_IOCTL_ALLOC, &allocation);
+        } while (result < 0 && errno == EINTR);
+        int savedErrno = errno;
+        close(heap);
+        errno = savedErrno;
+        if (result == 0)
+            return (int) allocation.fd;
+    }
+
+    return -1;
+}
+
+static int syncDmaBuf(int fd, uint64_t flags) {
+    struct dma_buf_sync sync = { .flags = flags };
+    int result;
+    do {
+        result = ioctl(fd, DMA_BUF_IOCTL_SYNC, &sync);
+    } while (result < 0 && errno == EINTR);
+    return result;
+}
