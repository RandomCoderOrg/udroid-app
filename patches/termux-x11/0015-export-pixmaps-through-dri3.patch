+__LIBC_HIDDEN__ int LorieBuffer_exportDmaBuf(LorieBuffer* buffer,
+                                              uint32_t* offset,
+                                              uint32_t* size) {
+    if (!buffer || !offset || !size || buffer->desc.type != LORIEBUFFER_FD ||
+        buffer->fd < 0 || buffer->offset < 0 || buffer->offset > UINT32_MAX ||
+        buffer->size > UINT32_MAX)
+        return -1;
+
+    if (syncDmaBuf(buffer->fd, DMA_BUF_SYNC_START | DMA_BUF_SYNC_READ) < 0)
+        return -1;
+    if (syncDmaBuf(buffer->fd, DMA_BUF_SYNC_END | DMA_BUF_SYNC_READ) < 0)
+        return -1;
+
+    int fd = fcntl(buffer->fd, F_DUPFD_CLOEXEC, 0);
+    if (fd >= 0) {
+        *offset = (uint32_t) buffer->offset;
+        *size = (uint32_t) buffer->size;
+    }
+    return fd;
+}
