@@ -548,6 +548,30 @@ __LIBC_HIDDEN__ int LorieBuffer_exportDmaBuf(LorieBuffer* buffer,
     return fd;
 }
 
+__LIBC_HIDDEN__ bool LorieBuffer_cpuAccessBegin(LorieBuffer* buffer, bool write) {
+    if (!buffer || buffer->desc.type != LORIEBUFFER_FD ||
+        buffer->dmaBufSyncSupport == DMA_BUF_SYNC_UNSUPPORTED)
+        return false;
+
+    if (syncDmaBuf(buffer->fd, DMA_BUF_SYNC_START | DMA_BUF_SYNC_READ |
+                               (write ? DMA_BUF_SYNC_WRITE : 0)) == 0) {
+        buffer->dmaBufSyncSupport = DMA_BUF_SYNC_SUPPORTED;
+        return true;
+    }
+
+    int error = errno;
+    if (buffer->dmaBufSyncSupport == DMA_BUF_SYNC_UNKNOWN &&
+        (error == ENOTTY || error == EINVAL || error == ENOSYS)) {
+        buffer->dmaBufSyncSupport = DMA_BUF_SYNC_UNSUPPORTED;
+    }
+    return false;
+}
+
+__LIBC_HIDDEN__ void LorieBuffer_cpuAccessEnd(LorieBuffer* buffer, bool write) {
+    syncDmaBuf(buffer->fd, DMA_BUF_SYNC_END | DMA_BUF_SYNC_READ |
+                           (write ? DMA_BUF_SYNC_WRITE : 0));
+}
