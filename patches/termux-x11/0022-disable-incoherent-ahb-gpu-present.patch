-void rendererTestCapabilities(int* legacy_drawing) {
+// Present GPU offload writes this buffer while Xorg keeps its CPU mapping locked.
+// Verify both views refer to coherent memory instead of guessing from the driver name.
+static bool cpuAndGpuShareAhbMemory(EGLDisplay display) {
+    const EGLint imageAttributes[] = {EGL_IMAGE_PRESERVED_KHR, EGL_TRUE, EGL_NONE};
+    AHardwareBuffer_Desc desc = {
+            .width = 64,
+            .height = 64,
+            .layers = 1,
+            .format = AHARDWAREBUFFER_FORMAT_R8G8B8X8_UNORM,
+            .usage = AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE | AHARDWAREBUFFER_USAGE_GPU_FRAMEBUFFER |
+                     AHARDWAREBUFFER_USAGE_CPU_WRITE_OFTEN | AHARDWAREBUFFER_USAGE_CPU_READ_OFTEN
+    };
+    AHardwareBuffer *buffer = NULL;
+    EGLImageKHR image = EGL_NO_IMAGE_KHR;
+    GLuint texture = 0, fbo = 0;
+    volatile uint32_t *pixels = NULL;
+    bool result = true;
+
+    if (AHardwareBuffer_allocate(&desc, &buffer) != 0 || !buffer)
+        return true;
+
+    EGLClientBuffer clientBuffer = eglGetNativeClientBufferANDROID(buffer);
+    if (clientBuffer)
+        image = eglCreateImageKHR(display, EGL_NO_CONTEXT, EGL_NATIVE_BUFFER_ANDROID, clientBuffer, imageAttributes);
+    if (image == EGL_NO_IMAGE_KHR)
+        goto out;
+
+    glGenTextures(1, &texture);
+    glBindTexture(GL_TEXTURE_2D, texture);
+    glEGLImageTargetTexture2DOES(GL_TEXTURE_2D, image);
+    glGenFramebuffers(1, &fbo);
+    glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, texture, 0);
+    if (glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE)
+        goto out;
+
+    if (AHardwareBuffer_lock(buffer, AHARDWAREBUFFER_USAGE_CPU_WRITE_OFTEN | AHARDWAREBUFFER_USAGE_CPU_READ_OFTEN,
+                             -1, NULL, (void **) &pixels) != 0 || !pixels)
+        goto out;
+    pixels[0] = 0;
+
+    glClearColor(0x11 / 255.f, 0x22 / 255.f, 0x33 / 255.f, 1.f);
+    glClear(GL_COLOR_BUFFER_BIT);
+    glFinish();
+
+    if ((pixels[0] & 0xffffff) != 0x332211) {
+        loge("CPU mapping does not see GPU writes (got %08x)", pixels[0]);
+        AHardwareBuffer_unlock(buffer, NULL);
+        result = false;
+        goto out;
+    }
+
+    AHardwareBuffer_unlock(buffer, NULL);
+    {
+        uint8_t pixel[4] = {0, 0, 0, 0};
+        glReadPixels(0, 0, 1, 1, GL_RGBA, GL_UNSIGNED_BYTE, pixel);
+        if (pixel[0] != 0x11 || pixel[1] != 0x22 || pixel[2] != 0x33) {
+            loge("CPU unlock overwrote GPU writes (got %02x%02x%02x)", pixel[0], pixel[1], pixel[2]);
+            result = false;
+        }
+    }
+
+out:
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    if (fbo)
+        glDeleteFramebuffers(1, &fbo);
+    if (texture)
+        glDeleteTextures(1, &texture);
+    if (image != EGL_NO_IMAGE_KHR)
+        eglDestroyImageKHR(display, image);
+    AHardwareBuffer_release(buffer);
+    return result;
+}
+
+void rendererTestCapabilities(int* legacy_drawing, int* gpu_present_disabled) {
     // Some devices do not support sampling from HAL_PIXEL_FORMAT_BGRA_8888, here we are checking it.
     const EGLint imageAttributes[] = {EGL_IMAGE_PRESERVED_KHR, EGL_TRUE, EGL_NONE};
     EGLint numConfigs;
@@ -428,7 +502,8 @@ void rendererTestCapabilities(int* legacy_drawing) {
             .width = 64,
             .height = 64,
             .layers = 1,
-            .usage = AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE | AHARDWAREBUFFER_USAGE_CPU_WRITE_OFTEN | AHARDWAREBUFFER_USAGE_CPU_READ_OFTEN,
+            .usage = AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE | AHARDWAREBUFFER_USAGE_GPU_FRAMEBUFFER |
+                     AHARDWAREBUFFER_USAGE_CPU_WRITE_OFTEN | AHARDWAREBUFFER_USAGE_CPU_READ_OFTEN,
             .format = AHARDWAREBUFFER_FORMAT_R8G8B8X8_UNORM
     };

@@ -503,6 +578,11 @@ void rendererTestCapabilities(int* legacy_drawing) {
         if (eglMakeCurrent(egl_display, checksfc, checksfc, testctx) != EGL_TRUE)
             return vprintEglError("check eglMakeCurrent failed", __LINE__);

+        if (!*gpu_present_disabled && !cpuAndGpuShareAhbMemory(egl_display)) {
+            loge("CPU and GPU views of AHardwareBuffer are not coherent on this device, disabling Present GPU offload");
+            *gpu_present_disabled = 1;
+        }
+
         glActiveTexture(GL_TEXTURE0); checkGlError();
         glGenTextures(1, &texture); checkGlError();
         bindTexture(texture);
