libX11: use Bionic's xlocale compatibility header

Including locale.h directly selects the glibc-oriented declarations. Include
Android's compatibility header when building the embedded libX11 instead.

--- a/include/X11/Xlocale.h
+++ b/include/X11/Xlocale.h
@@ -32,6 +32,10 @@
 #include <X11/Xfuncproto.h>
 #include <X11/Xosdefs.h>
 
+#ifdef __ANDROID__
+#include_next <xlocale.h>
+#else
 #include <locale.h>
+#endif
 
 #endif /* _X11_XLOCALE_H_ */
