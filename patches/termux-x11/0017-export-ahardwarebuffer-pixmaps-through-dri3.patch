+/*
+ * AHardwareBuffer exposes no public direct fd getter. Round-trip the native
+ * handle through the NDK socket API, then accept only a CPU-readable DMA-BUF.
+ */
+static int exportAHardwareBufferDmaBuf(AHardwareBuffer *buffer,
+                                       uint32_t minimumSize,
+                                       uint32_t *size) {
+    enum { MAX_HANDLE_FDS = 16 };
+    int sockets[2] = {-1, -1};
+    int receivedFds[MAX_HANDLE_FDS];
+    size_t receivedFdCount = 0;
+    int selectedFd = -1;
+    ssize_t receivedBytes;
+    char payload[4096];
+    char control[CMSG_SPACE(sizeof(int) * MAX_HANDLE_FDS)];
+    struct iovec iov = {
+        .iov_base = payload,
+        .iov_len = sizeof(payload),
+    };
+    struct msghdr message = {
+        .msg_iov = &iov,
+        .msg_iovlen = 1,
+        .msg_control = control,
+        .msg_controllen = sizeof(control),
+    };
+
+    if (!buffer || socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, sockets) != 0)
+        return -1;
+
+    if (AHardwareBuffer_sendHandleToUnixSocket(buffer, sockets[0]) != 0)
+        goto out;
+    close(sockets[0]);
+    sockets[0] = -1;

+    receivedBytes = recvmsg(sockets[1], &message, MSG_CMSG_CLOEXEC);
+    if (receivedBytes <= 0)
+        goto out;
+
+    for (struct cmsghdr *header = CMSG_FIRSTHDR(&message);
+         header && receivedFdCount < MAX_HANDLE_FDS;
+         header = CMSG_NXTHDR(&message, header)) {
+        if (header->cmsg_level != SOL_SOCKET || header->cmsg_type != SCM_RIGHTS)
+            continue;
+
+        size_t count = (header->cmsg_len - CMSG_LEN(0)) / sizeof(int);
+        int *fds = (int *)CMSG_DATA(header);
+        for (size_t i = 0; i < count && receivedFdCount < MAX_HANDLE_FDS; i++)
+            receivedFds[receivedFdCount++] = fds[i];
+    }
+
+    /* recvmsg may still install the descriptors that fit before reporting a
+     * truncated control message. Close those descriptors through out rather
+     * than attempting to interpret an incomplete native handle. */
+    if (message.msg_flags & MSG_CTRUNC)
+        goto out;
+
+    for (size_t i = 0; i < receivedFdCount; i++) {
+        struct stat info = {0};
+        int fd = receivedFds[i];
+
+        if (fstat(fd, &info) != 0 || info.st_size < minimumSize ||
+            info.st_size > UINT32_MAX)
+            continue;
+        if (syncDmaBuf(fd, DMA_BUF_SYNC_START | DMA_BUF_SYNC_READ) != 0)
+            continue;
+        if (syncDmaBuf(fd, DMA_BUF_SYNC_END | DMA_BUF_SYNC_READ) != 0)
+            continue;
+
+        selectedFd = fd;
+        *size = (uint32_t)info.st_size;
+        receivedFds[i] = -1;
+        break;
+    }
+
+out:
+    for (size_t i = 0; i < receivedFdCount; i++)
+        if (receivedFds[i] >= 0)
+            close(receivedFds[i]);
+    if (sockets[0] >= 0)
+        close(sockets[0]);
+    if (sockets[1] >= 0)
+        close(sockets[1]);
+    return selectedFd;
+}
