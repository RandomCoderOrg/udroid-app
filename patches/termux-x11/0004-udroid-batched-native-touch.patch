+static Bool readFully(int fd, void *destination, size_t size) {
+    uint8_t *cursor = destination;
+    while (size > 0) {
+        ssize_t received = read(fd, cursor, size);
+        if (received <= 0)
+            return FALSE;
+        cursor += received;
+        size -= received;
+    }
+    return TRUE;
+}
