+static void sendTouchFrame(
+        JNIEnv* env,
+        __unused jobject cls,
+        jintArray packed_events,
+        jint event_count
+) {
+    enum { TOUCH_EVENT_STRIDE = 4 };
+    if (conn_fd == -1 || !packed_events || event_count <= 0 ||
+        event_count > LORIE_MAX_TOUCH_CONTACTS)
+        return;
+
+    jsize packed_length = (*env)->GetArrayLength(env, packed_events);
+    if (packed_length < event_count * TOUCH_EVENT_STRIDE)
+        return;
+
+    jint packed[LORIE_MAX_TOUCH_CONTACTS * TOUCH_EVENT_STRIDE];
+    (*env)->GetIntArrayRegion(
+            env,
+            packed_events,
+            0,
+            event_count * TOUCH_EVENT_STRIDE,
+            packed
+    );
+    if ((*env)->ExceptionCheck(env))
+        return;
+
+    struct {
+        lorieEvent header;
+        lorieTouchPoint points[LORIE_MAX_TOUCH_CONTACTS];
+    } message = {
+            .header = { .touchFrame = { .t = EVENT_TOUCH_FRAME, .count = event_count } }
+    };
+
+    for (int index = 0; index < event_count; index++) {
+        int offset = index * TOUCH_EVENT_STRIDE;
+        message.points[index] = (lorieTouchPoint) {
+                .type = packed[offset],
+                .id = packed[offset + 1],
+                .x = packed[offset + 2],
+                .y = packed[offset + 3],
+        };
+    }
+    write(
+            conn_fd,
+            &message,
+            sizeof(message.header) + event_count * sizeof(message.points[0])
+    );
+}
